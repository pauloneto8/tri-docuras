APP1_DOMAIN=tridocuras.com.br
APP2_DOMAIN=assistfin.com.br
CERTBOT_EMAIL=seu-email@exemplo.com

# App 1 — banco isolado
APP1_DB_USER=app1
APP1_DB_PASSWORD=change_me
APP1_DB_NAME=app1

# App 1 — Mercado Pago (Pix) — produção
# Ative em https://www.mercadopago.com.br/developers/panel/app
APP1_MP_PUBLIC_KEY=
APP1_MP_ACCESS_TOKEN=
APP1_MP_CLIENT_ID=
APP1_MP_CLIENT_SECRET=
APP1_MP_USE_TEST=false

# App 1 — Mercado Pago — sandbox (só com APP1_MP_USE_TEST=true)
APP1_MP_TEST_ACCESS_TOKEN=
APP1_MP_TEST_PUBLIC_KEY=

# App 1 — Mercado Pago — assinatura do webhook (opcional, recomendado)
# Painel do MP > sua aplicação > Webhooks > "Configurar notificações" > chave secreta
APP1_MP_WEBHOOK_SECRET=

# App 1 — painel da loja (https://tridocuras.com.br/admin)
# Pedidos + CRUD de produtos
APP1_ADMIN_PASSWORD=change_me

# App 1 — notificação WhatsApp à loja quando Pix confirma (opcional)
# Provider: callmebot (simples) ou meta (WhatsApp Cloud API)
APP1_WHATSAPP_NOTIFY_ENABLED=false
APP1_WHATSAPP_PROVIDER=callmebot
APP1_STORE_WHATSAPP=5581999999999
APP1_STORE_WHATSAPP_DISPLAY=(81) 99999-9999
APP1_CALLMEBOT_API_KEY=
# Notificação automática ao cliente (somente provider meta + template aprovado)
APP1_WHATSAPP_NOTIFY_CUSTOMER=false
APP1_WHATSAPP_CUSTOMER_TEMPLATE=order_paid
APP1_WHATSAPP_CUSTOMER_TEMPLATE_LANG=pt_BR
# Para meta:
# APP1_WHATSAPP_PROVIDER=meta
# APP1_WHATSAPP_ACCESS_TOKEN=
# APP1_WHATSAPP_PHONE_NUMBER_ID=

# App 2 — banco isolado
APP2_DB_USER=app2
APP2_DB_PASSWORD=change_me
APP2_DB_NAME=app2
APP2_SECRET_KEY=change-me-generate-a-random-key
APP2_ALLOW_REGISTRATION=true
APP2_ROOT_EMAILS=seu-email@exemplo.com
APP2_GROQ_API_KEY=
APP2_GROQ_MODEL=openai/gpt-oss-120b

# App 2 — insight financeiro diário por LLM (cron; números calculados em Python)
APP2_ENABLE_AI_INSIGHTS=false
# Quem recebe o insight (separados por vírgula). Vazio = APP2_ROOT_EMAILS.
# Cada usuário custa ~2.500 tokens/dia no Groq free (200k/dia): deixar vazio
# geraria para todos os cadastrados e esgotaria o orçamento do chat.
APP2_INSIGHTS_EMAILS=

# App 2 — agente autônomo v2 (loop de ferramentas no Groq; o legado é o fallback)
# Liga o motor v2. Manter false para rollback imediato.
APP2_ENABLE_AGENT_V2=false
# Ids de usuário (separados por vírgula) que usam o v2. Vazio = só o fallback legado.
APP2_AGENT_V2_USERS=

# App 2 — Telegram (bot do @BotFather; sem token o canal fica inativo)
APP2_TELEGRAM_BOT_TOKEN=
# Segredo do webhook (openssl rand -hex 32); o Telegram envia como X-Telegram-Bot-Api-Secret-Token
APP2_TELEGRAM_WEBHOOK_SECRET=

# App 2 — WhatsApp (Meta Cloud API; sem credenciais o canal fica inativo)
APP2_WHATSAPP_ACCESS_TOKEN=
APP2_WHATSAPP_PHONE_NUMBER_ID=
# Token do GET de verificação do webhook (openssl rand -hex 24)
APP2_WHATSAPP_VERIFY_TOKEN=
# App secret da Meta; valida a assinatura X-Hub-Signature-256
APP2_WHATSAPP_APP_SECRET=
