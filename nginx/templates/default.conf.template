server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Qualquer Host não reconhecido (IP direto, domínio antigo, scanner)
    # não deve cair no App1 por padrão — apenas fecha a conexão.
    location / {
        return 444;
    }
}
